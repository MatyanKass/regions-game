; Regions - notebook-style 2D grid strategy.
; Engine configuration. Edited by hand and by the Godot editor.

config_version=5

[application]

config/name="Regions"
config/description="Notebook-style 2D grid strategy for two players over LAN."
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://src/ui/main.tscn"

[autoload]

; The connection, the match clock and the shared simulation. Autoloaded so that both
; devices address it by the same node path, which is what Godot RPCs require.
Net="*res://src/net/net_match.gd"

; Background music. Silent until tracks are dropped into assets/music.
Music="*res://src/ui/music.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; Off-map area reads as the darker edge of the sheet rather than engine grey.
environment/defaults/default_clear_color=Color(0.902, 0.874, 0.796, 1)

; Required for Android exports. The game draws with lines rather than textures, so this
; costs nothing here beyond satisfying the exporter.
textures/vram_compression/import_etc2_astc=true

[input_devices]

; One code path for taps on a phone and clicks on a desktop during development.
pointing/emulate_touch_from_mouse=true
